# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (PostgreSQL via Prisma)
# For local dev against `docker-compose up -d postgres`, host is localhost.
# Inside docker-compose the web service overrides host to `postgres`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public
