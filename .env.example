# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# PostgreSQL is required for creation and resolution, but not home rendering.
# Host commands connect to POSTGRES_HOST:POSTGRES_PORT.
# Docker Compose web/migrations use postgres:5432 instead.
# Optional container public origin override (PUBLIC_URL remains the host setting).
DOCKER_PUBLIC_URL=http://localhost:3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=url_shortener_dev
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=local_password
