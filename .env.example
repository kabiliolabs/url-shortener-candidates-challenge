# Application
NODE_ENV=development

# Public origin used to build the short links.
# 5173 in development, 3000 in Docker (set by docker-compose.yml).
PUBLIC_URL=http://localhost:5173

# SQLite connection string.
# Optional in development: the app defaults to applications/web/prisma/data/dev.db.
# In Docker this points at the mounted volume (file:/app/data/app.db).
# DATABASE_URL=file:/absolute/path/to/dev.db
