# Application
NODE_ENV=development

# Public origin used to build the short links.
# 5173 in development, 3000 in Docker (set by docker-compose.yml).
PUBLIC_URL=http://localhost:5173

# Postgres connection string.
# Optional in development: defaults to the database published by
# `docker compose up -d db` on port 5433. Required in production.
# DATABASE_URL=postgresql://urlshortener:urlshortener@localhost:5433/urlshortener?schema=public
