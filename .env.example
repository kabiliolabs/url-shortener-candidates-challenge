# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (PostgreSQL)
# Database credentials for both local development and Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener
# Connection string for the PostgreSQL database
# For local dev: run postgres locally or via docker-compose up db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener?schema=public

# Cache (Redis)
# Connection string for the Redis cache used for rate limiting and caching
REDIS_URL=redis://localhost:6379

# Google reCAPTCHA v3
# Used to protect URL creation from bots
# Get production keys at: https://www.google.com/recaptcha/admin (or read https://developers.google.com/recaptcha/docs/v3)
# Or ask for temporary credentials to be shared for testing
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Logging
# Supported levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
