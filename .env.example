# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Abuse protection
# Set to true only when the app runs behind exactly one reverse proxy that
# appends the client IP to X-Forwarded-For. Rate limits are then counted per
# client IP. With false, the header is ignored (a client could forge it) and
# all clients share a single limit.
TRUST_PROXY=false

# Database
# Matches the `db` service in docker-compose.yml, reached through its published port.
# The Prisma CLI reads its own copy in libs/engine/.env.
DATABASE_URL=postgresql://shortener:shortener@localhost:5432/shortener?schema=public
