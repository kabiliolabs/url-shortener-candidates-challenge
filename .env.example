# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://url_shortener:url_shortener@localhost:5432/url_shortener?schema=public

# Abuse protection (optional; defaults shown)
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# MAX_BODY_BYTES=8192
# FRONTEND_ORIGIN defaults to the origin of PUBLIC_URL
# FRONTEND_ORIGIN=http://localhost:5173
