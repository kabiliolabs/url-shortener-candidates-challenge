# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (PostgreSQL). For Docker: postgresql://urlshortener:urlshortener@localhost:5432/urlshortener
# Create DB and run: cd applications/web && npx prisma migrate deploy
DATABASE_URL="postgresql://urlshortener:urlshortener@localhost:5432/urlshortener"
