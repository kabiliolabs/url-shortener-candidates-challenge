# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Local PostgreSQL connection for running the web app outside Docker
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://shortener:shortener_dev_password@localhost:5433/shortener?schema=public
