# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (SQLite file, path resolved relative to libs/engine/prisma/schema.prisma)
# Docker overrides this to file:/app/data/prod.db (see docker-compose.yml) — not used from here.
DATABASE_URL="file:./dev.db"
