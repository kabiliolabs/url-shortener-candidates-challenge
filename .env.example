# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database
# Matches the `db` service in docker-compose.yml, reached through its published port.
# The Prisma CLI reads its own copy in libs/engine/.env.
DATABASE_URL=postgresql://shortener:shortener@localhost:5432/shortener?schema=public
