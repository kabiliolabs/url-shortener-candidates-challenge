# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Local PostgreSQL only; the web app does not require these settings.
# Host commands connect to POSTGRES_HOST:POSTGRES_PORT.
# Containers on the Compose network would use postgres:5432 instead.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=url_shortener_dev
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=local_password
