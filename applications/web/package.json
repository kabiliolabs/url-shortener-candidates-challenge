    "@tanstack/react-query": "^5.100.9",
    "@url-shortener/engine": "workspace:*",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "isbot": "^5.1.31",
    "jotai": "^2.20.0",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
