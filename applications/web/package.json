{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build",
    "clean": "rm -rf build generated .react-router .turbo",
    "dev": "prisma generate && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "prisma generate && react-router typegen && tsc",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@url-shortener/engine": "workspace:*",
    "isbot": "^5.1.31",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^18.0.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
