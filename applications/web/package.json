    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "7.8.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
