{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rm -rf build .react-router .turbo",
    "dev": "react-router dev",
    "start": "prisma migrate deploy && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=\"file:./data/dev.db\" prisma migrate dev",
    "db:studio": "DATABASE_URL=\"file:./data/dev.db\" prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@url-shortener/engine": "workspace:*",
    "isbot": "^5.1.31",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
