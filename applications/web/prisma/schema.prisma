generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id          String    @id @default(cuid())
  code        String    @unique
  originalUrl String    @unique
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  lastClickAt DateTime?
}
