generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortLink {
  id        String   @id @default(cuid())
  url       String   @unique @db.Text
  code      String   @unique
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}
