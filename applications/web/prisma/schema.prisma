generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ShortenedUrl {
  id          String   @id @default(uuid())
  shortCode   String   @unique
  originalUrl String   @unique
  clicks      Int      @default(0)
  createdAt   DateTime
}
