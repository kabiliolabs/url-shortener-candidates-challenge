{
  "name": "@url-shortener/database",
  "version": "0.0.1",
  "type": "module",
  "main": "src/prisma.ts",
  "types": "src/prisma.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "clean": "rm -rf dist generated tsconfig.tsbuildinfo .turbo",
    "dev": "tsc --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "@url-shortener/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@types/pg": "^8.15.5",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
