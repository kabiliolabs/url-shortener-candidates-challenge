generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Url {
  id        Int     @id @default(autoincrement())
  url       String  @unique
  shortCode String  @unique
  shortenCount Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

