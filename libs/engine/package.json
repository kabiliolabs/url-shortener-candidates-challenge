{
  "name": "@url-shortener/engine",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .turbo",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:all": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "testcontainers": "^10.13.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
