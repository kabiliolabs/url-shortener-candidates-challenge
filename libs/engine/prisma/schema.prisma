generator client {
  provider = "prisma-client-js"
  // The production image is Alpine (musl). Both architectures are listed so the
  // same image builds on Intel/AMD machines and on Apple Silicon.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortUrl {
  // Surrogate key, never exposed: the public identifier is `code`.
  id          Int      @id @default(autoincrement())
  // The UNIQUE constraint is what guarantees uniqueness under concurrency.
  // The application relies on the insert failing, not on a prior lookup.
  code        String   @unique
  originalUrl String   @map("original_url")
  clicks      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("short_urls")
}
