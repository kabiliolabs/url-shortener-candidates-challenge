generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ShortUrl {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  originalUrl   String
  clickCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastClickedAt DateTime?
}
