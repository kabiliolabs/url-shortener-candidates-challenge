{
  "name": "@url-shortener/infrastructure",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .turbo",
    "test": "dotenv -e ../../.env -- vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@url-shortener/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
