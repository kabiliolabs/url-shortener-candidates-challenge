{
  "name": "@url-shortener/core",
  "version": "0.0.1",
  "type": "module",
  "main": "url-shortener/index.ts",
  "types": "url-shortener/index.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -v DATABASE_URL=file:./dev.db -- prisma generate",
    "db:push": "dotenv -v DATABASE_URL=file:./dev.db -- prisma db push",
    "db:studio": "dotenv -v DATABASE_URL=file:./dev.db -- prisma studio"
  },
  "exports": {
    ".": "./url-shortener/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "typescript": "^5.9.3"
  }
}
