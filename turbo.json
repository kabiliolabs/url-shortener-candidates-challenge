{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "app/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "vitest.config.ts",
        "vitest.setup.ts"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
